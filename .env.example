# ==========================================
# Zepp Life (原小米运动) 自动刷步数环境变量配置文件模板
# 使用方法：复制本文件重命名为 .env，并填入你的实际配置
# ==========================================

# 1. 账号与密码（必填）
# 支持单个账号，或多个账号用 # 分隔（例如：13800000000#abc@qq.com）
USER=13800000000
PWD=your_password

# 2. 每日固定随机目标（北京时间，每天 70000 ~ 80000，同一天重试保持一致）
MIN_STEP=70000
MAX_STEP=80000

# 3. 本地加密密钥（选填）
# 建议配置 16 位字符串密钥，用于保存和加密 Token 及已绑定设备 ID，加速后续登录
AES_KEY=1234567890123456

# 4. 多账号执行配置（选填）
SLEEP_GAP=5
USE_CONCURRENT=False

# 5. 推送服务通知配置（选填）
# PushPlus 推送配置
PUSH_PLUS_TOKEN=
PUSH_PLUS_HOUR=
PUSH_PLUS_MAX=30

# 企业微信 Webhook 机器人推送配置
PUSH_WECHAT_WEBHOOK_KEY=

# Telegram Bot 推送配置
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 6. JSON 格式全量配置（选填）
# GitHub Actions 环境中使用的 CONFIG 变量范例
# CONFIG='{"USER": "13800000000", "PWD": "your_password", "MIN_STEP": "70000", "MAX_STEP": "80000"}'
